{
  "uid": "team2-calendar",
  "title": "Team 2 Calendar — release $release",
  "schemaVersion": 39,
  "version": 1,
  "tags": [
    "team2",
    "calendar",
    "golden-signals"
  ],
  "timezone": "utc",
  "refresh": "10s",
  "time": {
    "from": "now-30m",
    "to": "now"
  },
  "editable": true,
  "templating": {
    "list": [
      {
        "name": "release",
        "label": "Deployed release",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "query": {
          "query": "label_values(calendar_worker_capacity, release)",
          "refId": "release"
        },
        "refresh": 1,
        "multi": true,
        "includeAll": true,
        "allValue": ".*",
        "current": {
          "text": "All",
          "value": "$__all"
        }
      },
      {
        "name": "operation",
        "label": "Operation",
        "type": "custom",
        "query": "Create,Get,Replace,Delete",
        "multi": true,
        "includeAll": true,
        "allValue": ".*",
        "current": {
          "text": "All",
          "value": "$__all"
        }
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "title": "Latency p95 by operation",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95, sum by (le, operation, release) (rate(calendar_request_duration_seconds_bucket{release=~\"$release\",operation=~\"$operation\"}[$__rate_interval])))",
          "legendFormat": "{{operation}} {{release}}",
          "exemplar": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "min": 0,
          "links": [
            {
              "title": "Request outcomes → View trace",
              "url": "/d/team2-calendar?var-release=${release:percentencode}&var-operation=${__field.labels.operation}&from=${__from}&to=${__to}&viewPanel=6"
            }
          ]
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 2,
      "title": "Traffic by operation",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (operation, release) (rate(calendar_requests_total{release=~\"$release\",operation=~\"$operation\"}[$__rate_interval]))",
          "legendFormat": "{{operation}} {{release}}",
          "exemplar": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "min": 0,
          "links": [
            {
              "title": "Request outcomes → View trace",
              "url": "/d/team2-calendar?var-release=${release:percentencode}&var-operation=${__field.labels.operation}&from=${__from}&to=${__to}&viewPanel=6"
            }
          ]
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 3,
      "title": "Errors by operation and category",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (operation, outcome, release) (rate(calendar_errors_total{release=~\"$release\",operation=~\"$operation\"}[$__rate_interval]))",
          "legendFormat": "{{operation}} {{outcome}} {{release}}",
          "exemplar": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "min": 0,
          "links": [
            {
              "title": "Request outcomes → View trace",
              "url": "/d/team2-calendar?var-release=${release:percentencode}&var-operation=${__field.labels.operation}&from=${__from}&to=${__to}&viewPanel=6"
            }
          ]
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 4,
      "title": "Saturation: occupied sync workers / actual worker limit",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "max by (release) (calendar_worker_utilization_ratio{release=~\"$release\"})",
          "legendFormat": "{{release}}",
          "exemplar": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0,
          "links": []
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 5,
      "title": "Actual worker capacity by release",
      "type": "table",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 16,
        "w": 24,
        "h": 5
      },
      "targets": [
        {
          "refId": "A",
          "expr": "calendar_worker_capacity{release=~\"$release\"}",
          "instant": true,
          "format": "table"
        }
      ]
    },
    {
      "id": 6,
      "title": "Request outcomes — open trace_id → View trace",
      "type": "logs",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "gridPos": {
        "x": 0,
        "y": 21,
        "w": 24,
        "h": 12
      },
      "targets": [
        {
          "refId": "A",
          "expr": "{service_name=\"team2-calendar\"} | json | status != \"\" | release =~ \"$release\" | operation =~ \"$operation\"",
          "queryType": "range"
        }
      ],
      "options": {
        "showTime": true,
        "showLabels": false,
        "wrapLogMessage": true,
        "sortOrder": "Descending",
        "dedupStrategy": "none",
        "enableLogDetails": true
      }
    }
  ]
}
