# DRAFT for a dedicated Team 2 Alertmanager. Not loaded by any deployment.
# For a shared instance, merge a service-scoped child route; do not replace its root.
# The operator must choose the real channel and mount the webhook as a secret.

route:
  receiver: team2-calendar
  group_by: [alertname, service]
  group_wait: 30s
  group_interval: 1m
  repeat_interval: 1h

receivers:
  - name: team2-calendar
    slack_configs:
      - api_url_file: /run/secrets/team2-calendar-slack-webhook
        channel: '#REPLACE_WITH_TEAM2_ALERT_CHANNEL'
        send_resolved: true
        title: '[{{ .Status }}] {{ .CommonLabels.service }} {{ .CommonLabels.alertname }}'
        text: |-
          {{ range .Alerts }}{{ .Annotations.summary }}
          {{ .Annotations.description }}
          Dashboard: {{ .Annotations.dashboard_url }}
          Runbook: {{ .Annotations.runbook_url }}
          {{ end }}
